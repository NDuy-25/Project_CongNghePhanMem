@{
    ViewBag.Title = "Xác thực OTP quên mật khẩu";
}


<div class="form-wrapper">
    <div class="form-box">
        <h3>Xác thực OTP quên mật khẩu</h3>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        @using (Html.BeginForm("XacThucOTPReset", "NguoiDungs", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="text" name="otp" class="form-control" placeholder="Nhập mã OTP từ email" required />
            <button type="submit" class="btn-change">Xác nhận</button>
        }
    </div>
</div>

