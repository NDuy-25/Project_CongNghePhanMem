@model App12COFFEE.Models.SanPham
@{
    ViewBag.Title = "Sửa sản phẩm";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    h2 {
        color: #C9A86A;
        margin-bottom: 20px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        color: #fff;
        margin-bottom: 5px;
        display: block;
    }

    .form-control {
        background: #222;
        color: #fff;
        border: 1px solid #444;
        border-radius: 5px;
        padding: 8px;
    }

    .btn {
        padding: 8px 16px;
        border-radius: 5px;
        text-decoration: none;
        margin-right: 5px;
    }

    .btn-warning {
        background: #ffc107;
        color: #000;
    }

        .btn-warning:hover {
            background: #e0a800;
        }

    .btn-secondary {
        background: #6c757d;
        color: #fff;
    }

        .btn-secondary:hover {
            background: #5a6268;
        }
</style>

<h2>Sửa sản phẩm</h2>

@using (Html.BeginForm("SuaSanPham", "SanPhamAdmin_65130628", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.MaSP)

    <div class="form-group">
        @Html.LabelFor(m => m.TenSP, "Tên sản phẩm")
        @Html.TextBoxFor(m => m.TenSP, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.Label("Danh mục")
        @Html.DropDownList("MaDM", new SelectList(ViewBag.DanhMuc, "MaDM", "TenDM", Model.MaDM), "-- Chọn danh mục --", new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Gia, "Giá (VND)")
        @Html.TextBoxFor(m => m.Gia, new { @class = "form-control", type = "number", min = "0" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.SoLuongTon, "Số lượng tồn")
        @Html.TextBoxFor(m => m.SoLuongTon, new { @class = "form-control", type = "number", min = "0" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.MoTa, "Mô tả")
        @Html.TextAreaFor(m => m.MoTa, new { @class = "form-control", rows = 3 })
    </div>

    <div class="form-group">
        @Html.Label("Trạng thái")
        @Html.DropDownListFor(m => m.TrangThai,
            new SelectList(new[]
            {
                new { Value = true, Text = "Đang bán" },
                new { Value = false, Text = "Ngừng bán" }
            }, "Value", "Text", Model.TrangThai),
            "-- Chọn trạng thái --",
            new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-warning">Cập nhật</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Quay lại</a>
}