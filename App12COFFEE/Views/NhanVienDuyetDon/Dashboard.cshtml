@{
    ViewBag.Title = "Nhân Viên Duyệt Đơn";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    h2 {
        color: #C9A86A;
        margin-bottom: 20px;
    }

    .dashboard {
        display: flex;
        gap: 20px;
        flex-wrap: wrap;
        margin-top: 30px;
    }

    .card {
        flex: 1;
        min-width: 200px;
        background: #222;
        color: #fff;
        padding: 20px;
        border-radius: 8px;
        text-align: center;
        box-shadow: 0 0 10px rgba(0,0,0,0.5);
    }

        .card h3 {
            margin-bottom: 10px;
            color: #C9A86A;
        }

        .card p {
            font-size: 20px;
            font-weight: bold;
        }
</style>

<h2>Xin chào!</h2>
<p>Chào mừng bạn đến với hệ thống quản trị 12 COFFEE. Dưới đây là thông tin tổng quan:</p>

<div class="dashboard">
    <div class="card">
        <h3>Tổng số người dùng</h3>
        <p>@ViewBag.TongNguoiDung</p>
    </div>
    <div class="card">
        <h3>Tổng số sản phẩm</h3>
        <p>@ViewBag.TongSanPham</p>
    </div>
    <div class="card">
        <h3>Đơn hàng chờ xác nhận</h3>
        <p>@ViewBag.DonHangChoXacNhan</p>
    </div>
    <div class="card">
        <h3>Đơn hàng đã duyệt</h3>
        <p>@ViewBag.DonHangDaDuyet</p>
    </div>
</div>