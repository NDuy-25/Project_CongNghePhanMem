@model IEnumerable<App12COFFEE.Models.DonHang>
@{
    ViewBag.Title = "Nhân viên duyệt đơn";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var nhanVienGiaoHang = ViewBag.NhanVienGiaoHang as IEnumerable<App12COFFEE.Models.NguoiDung>;
}
<style>
.page-panel{background:#fff;border-radius:14px;padding:24px;box-shadow:0 12px 35px rgba(15,23,42,.08);margin-bottom:20px}
.page-title{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:18px}
.page-title h2{margin:0;color:#3b2416;font-weight:800}
.muted{color:#64748b}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px}
.item-card{border:1px solid #e2e8f0;border-radius:12px;padding:16px;background:#fff}
.table-clean{width:100%;border-collapse:collapse}.table-clean th,.table-clean td{padding:12px;border-bottom:1px solid #edf2f7;text-align:left;vertical-align:top}
.badge-soft{display:inline-block;padding:4px 10px;border-radius:999px;background:#fef3c7;color:#92400e;font-weight:700;font-size:12px}
.btn-main{display:inline-block;background:#7c3f16;color:#fff!important;border:0;border-radius:8px;padding:9px 14px;text-decoration:none;font-weight:700}
.btn-light{display:inline-block;background:#f8fafc;color:#334155!important;border:1px solid #cbd5e1;border-radius:8px;padding:8px 12px;text-decoration:none}
.btn-danger-soft{display:inline-block;background:#fee2e2;color:#991b1b!important;border:1px solid #fecaca;border-radius:8px;padding:8px 12px;text-decoration:none}
input,select,textarea{border:1px solid #cbd5e1;border-radius:8px;padding:9px 11px;width:100%;box-sizing:border-box}label{font-weight:700;margin:8px 0 4px;display:block}
</style>
<div class="grid">
    <div class="item-card"><strong>Tổng người dùng</strong><h2>@ViewBag.TongNguoiDung</h2></div>
    <div class="item-card"><strong>Tổng sản phẩm</strong><h2>@ViewBag.TongSanPham</h2></div>
    <div class="item-card"><strong>Đơn chờ xác nhận</strong><h2>@ViewBag.DonHangChoXacNhan</h2></div>
    <div class="item-card"><strong>Đơn đã duyệt</strong><h2>@ViewBag.DonHangDaDuyet</h2></div>
</div>
<div class="page-panel">
    <div class="page-title"><h2>Duyệt đơn và phân công giao hàng</h2></div>
    @if (TempData["Message"] != null) { <div class="item-card">@TempData["Message"]</div> }
    <table class="table-clean">
        <thead><tr><th>Đơn</th><th>Khách hàng</th><th>Chi tiết</th><th>Thanh toán</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
        <tbody>
        @foreach (var dh in Model) {
            var tt = dh.ThanhToans.FirstOrDefault();
            <tr>
                <td>#@dh.MaDH<br /><small>@(dh.NgayDat.HasValue ? dh.NgayDat.Value.ToString("dd/MM/yyyy HH:mm") : "")</small></td>
                <td>@(dh.NguoiDung != null ? dh.NguoiDung.HoTen : dh.MaND.ToString())<br /><small>@(dh.NguoiDung != null ? dh.NguoiDung.DienThoai : "")</small></td>
                <td>@String.Join(", ", dh.ChiTietDonHangs.Select(ct => (ct.SanPham != null ? ct.SanPham.TenSP : "SP") + " x" + (ct.SoLuong ?? 0)))<br /><strong>@String.Format("{0:N0}đ", dh.TongTien ?? 0)</strong></td>
                <td>@(tt != null ? tt.PhuongThuc + " - " + tt.TrangThai : "Chưa có")</td>
                <td><span class="badge-soft">@dh.TrangThaiDon</span></td>
                <td>
                    @if (dh.TrangThaiDon == "Chờ xác nhận") {
                        using (Html.BeginForm("DuyetDon", "NhanVienDuyetDon", FormMethod.Post)) {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="maDH" value="@dh.MaDH" />
                            <select name="maNVGiaoHang">
                                <option value="">Chọn NV giao hàng</option>
                                @foreach (var nv in nhanVienGiaoHang) { <option value="@nv.MaND">@nv.HoTen</option> }
                            </select>
                            <button class="btn-main" type="submit" style="margin-top:8px">Duyệt</button>
                        }
                        using (Html.BeginForm("TuChoiDon", "NhanVienDuyetDon", FormMethod.Post)) {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="maDH" value="@dh.MaDH" />
                            <input name="lyDo" placeholder="Lý do từ chối" style="margin-top:8px" />
                            <button class="btn-danger-soft" type="submit" style="margin-top:8px">Từ chối</button>
                        }
                    } else { <span class="muted">Đã xử lý</span> }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
