@model App12COFFEE.Models.DonHang
@{
    ViewBag.Title = "Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    h2 {
        color: #C9A86A;
        margin-bottom: 20px;
    }

    .info-table {
        width: 60%;
        border-collapse: collapse;
        margin-bottom: 30px;
    }

        .info-table th, .info-table td {
            padding: 10px;
            border: 1px solid #444;
            text-align: left;
        }

        .info-table th {
            background: #333;
            color: #fff;
            width: 30%;
        }

    .items-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

        .items-table th, .items-table td {
            padding: 10px;
            border: 1px solid #444;
            text-align: center;
        }

        .items-table th {
            background: #333;
            color: #fff;
        }

        .items-table tbody tr:nth-child(odd) {
            background: #222;
        }

        .items-table tbody tr:hover {
            background: #444;
        }

    .btn {
        padding: 8px 16px;
        background: #C9A86A;
        color: #000;
        border-radius: 5px;
        text-decoration: none;
    }

        .btn:hover {
            background: #b8974d;
        }
</style>

<h2>Chi tiết đơn hàng</h2>

<table class="info-table">
    <tr><th>Mã đơn hàng</th><td>@Model.MaDH</td></tr>
    <tr><th>Ngày đặt</th><td>@Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</td></tr>
    <tr><th>Tổng tiền</th><td>@String.Format("{0:N0}", Model.TongTien) VND</td></tr>
</table>

<h3 style="color:#C9A86A;">Danh sách món đã đặt</h3>
<table class="items-table">
    <thead>
        <tr>
            <th>Tên món</th>
            <th>Số lượng</th>
            <th>Đơn giá (VND)</th>
            <th>Thành tiền (VND)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ct in Model.ChiTietDonHangs)
        {
            <tr>
                <td>@ct.SanPham.TenSP</td>
                <td>@ct.SoLuong</td>
                <td>@String.Format("{0:N0}", ct.DonGia)</td>
                <td>@String.Format("{0:N0}", ct.SoLuong * ct.DonGia)</td>
            </tr>
        }
    </tbody>
</table>

<a href="@Url.Action("Index")" class="btn">Quay lại</a>