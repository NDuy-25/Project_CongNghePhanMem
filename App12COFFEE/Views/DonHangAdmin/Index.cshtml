
@{
    ViewBag.Title = "Quản lý đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    h2 {
        color: #C9A86A;
        margin-bottom: 20px;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

        .table th, .table td {
            padding: 10px;
            border: 1px solid #444;
            text-align: center;
        }

        .table th {
            background: #333;
            color: #fff;
        }

        .table tbody tr:nth-child(odd) {
            background: #222;
        }

        .table tbody tr:hover {
            background: #444;
        }

    .btn {
        padding: 6px 12px;
        background: #C9A86A;
        color: #000;
        border-radius: 5px;
        text-decoration: none;
        margin: 0 3px;
        display: inline-block;
    }

        .btn:hover {
            background: #b8974d;
        }

    .btn-warning {
        background: #ffc107;
        color: #000;
    }

        .btn-warning:hover {
            background: #e0a800;
        }

    .btn-danger {
        background: #dc3545;
        color: #fff !important;
    }

        .btn-danger:hover {
            background: #b52a37;
        }

    .btn-disabled {
        background: #666 !important;
        color: #ccc !important;
        cursor: not-allowed !important;
        pointer-events: none;
        opacity: .7;
    }

    /* Màu trạng thái */
    .pay-cod {
        color: #C9A86A;
        font-weight: bold;
    }

    .pay-qr {
        color: #4dd0e1;
        font-weight: bold;
    }

    .pay-wait {
        color: #ff9800;
        font-weight: bold;
    }
</style>

<h2>Đơn hàng chờ xác nhận</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Mã đơn</th>
            <th>Khách hàng</th>
            <th>Ngày đặt</th>
            <th>Tổng tiền (VND)</th>
            <th>Phương thức</th>
            <th>Trạng thái thanh toán</th>
            <th>Trạng thái đơn</th>
            <th>Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var dh in Model)
        {
            var tt = dh.ThanhToans.FirstOrDefault();

            // Chuẩn hóa phương thức
            string pttt = tt?.PhuongThuc ?? "";
            bool isCOD = (pttt == "COD" || pttt == "TienMat");
            bool isQR = (pttt == "VietQR" || pttt == "PayOS_QR");

            // Điều kiện được duyệt:
            // - COD: luôn được duyệt
            // - QR: chỉ được duyệt khi đã thanh toán
            bool daThanhToan = (tt != null && tt.TrangThai == "Đã thanh toán");
            bool coTheDuyet = isCOD || (isQR && daThanhToan);

            <tr>
                <td>@dh.MaDH</td>

                <td>
                    @if (dh.NguoiDung != null)
                    {
                        @dh.NguoiDung.HoTen
                    }
                    else
                    {
                        @dh.MaND
                    }
                </td>

                <td>@(dh.NgayDat.HasValue ? dh.NgayDat.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa có")</td>
                <td>@String.Format("{0:N0}", dh.TongTien) VND</td>

                <!-- PHƯƠNG THỨC THANH TOÁN -->
                <td>
                    @if (tt != null)
                    {
                        if (isCOD)
                        {
                            <span class="pay-cod">COD</span>
                        }
                        else if (isQR)
                        {
                            <span class="pay-qr">VietQR</span>
                        }
                        else
                        {
                            @tt.PhuongThuc
                        }
                    }
                    else
                    {
                        <span style="color:gray">Không có</span>
                    }
                </td>

                <!-- TRẠNG THÁI THANH TOÁN -->
                <td>
                    @if (tt != null)
                    {
                        if (tt.TrangThai == "Chờ thanh toán")
                        {
                            <span class="pay-wait">Chờ thanh toán</span>
                        }
                        else if (tt.TrangThai == "Chờ xử lý")
                        {
                            <span class="pay-cod">Chờ xử lý</span>
                        }
                        else if (tt.TrangThai == "Đã thanh toán")
                        {
                            <span style="color:limegreen; font-weight:bold;">Đã thanh toán</span>
                        }
                        else
                        {
                            @tt.TrangThai
                        }
                    }
                    else
                    {
                        <span style="color:gray">Không có</span>
                    }
                </td>

                <td>@dh.TrangThaiDon</td>

                <td>
                    <a href="@Url.Action("Details", "DonHangAdmin", new { id = dh.MaDH })" class="btn">Chi tiết</a>
                    <a href="@Url.Action("Edit", "DonHangAdmin", new { id = dh.MaDH })" class="btn">Sửa</a>
                    <a href="@Url.Action("Delete", "DonHangAdmin", new { id = dh.MaDH })" class="btn btn-danger">Xóa</a>

                    @if (coTheDuyet)
                    {
                        <a href="@Url.Action("DuyetDon", "DonHangAdmin", new { maDH = dh.MaDH })"
                           class="btn btn-warning"
                           onclick="return confirm('Bạn có chắc muốn duyệt đơn này?');">
                            Duyệt đơn
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-warning btn-disabled"
                           title="Đơn VietQR chưa thanh toán nên không thể duyệt">
                            Chưa thanh toán
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

