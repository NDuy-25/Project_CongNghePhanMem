
@{
    ViewBag.Title = "Sửa đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    h2 {
        color: #C9A86A;
        margin-bottom: 20px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        display: block;
        margin-bottom: 5px;
        color: #fff;
    }

    .form-control {
        width: 300px;
        padding: 8px;
        border-radius: 5px;
        border: 1px solid #444;
        background: #222;
        color: #fff;
    }

    .btn {
        padding: 6px 12px;
        background: #C9A86A;
        color: #000;
        border-radius: 5px;
        text-decoration: none;
        margin-right: 5px;
    }

        .btn:hover {
            background: #b8974d;
        }

    .btn-danger {
        background: #dc3545;
        color: #fff !important;
    }

        .btn-danger:hover {
            background: #b52a37;
        }

    .items-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

        .items-table th, .items-table td {
            padding: 10px;
            border: 1px solid #444;
            text-align: center;
        }

        .items-table th {
            background: #333;
            color: #fff;
        }
</style>

<h2>Sửa đơn hàng</h2>

<!-- Thông tin chung -->
<div class="form-group">
    <label>Mã đơn hàng</label>
    <span>@Model.MaDH</span>
</div>
<div class="form-group">
    <label>Ngày đặt</label>
    <span>@Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</span>
</div>
<div class="form-group">
    <label>Tổng tiền</label>
    <span>@String.Format("{0:N0}", Model.TongTien) VND</span>
</div>

<!-- Danh sách món -->
<h3 style="color:#C9A86A;">Danh sách món đã đặt</h3>
<table class="items-table">
    <thead>
        <tr>
            <th>Tên món</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ct in Model.ChiTietDonHangs)
        {
            <tr>
                <td>@ct.SanPham.TenSP</td>
                <td>@ct.SoLuong</td>
                <td>@String.Format("{0:N0}", ct.DonGia)</td>
                <td>@String.Format("{0:N0}", ct.SoLuong * ct.DonGia)</td>
                <td>
                    @using (Html.BeginForm("XoaMon", "DonHangAdmin_65130628", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maDH" value="@Model.MaDH" />
                        <input type="hidden" name="maSP" value="@ct.MaSP" />
                        <button type="submit" class="btn btn-danger">Xóa</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Form thêm món -->
<h3 style="color:#C9A86A; margin-top:30px;">Thêm món vào đơn hàng</h3>
@using (Html.BeginForm("ThemMon", "DonHangAdmin_65130628", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="maDH" value="@Model.MaDH" />
    <div class="form-group">
        <label>Chọn món</label>
        @Html.DropDownList("maSP", (SelectList)ViewBag.SanPhamList, "-- Chọn sản phẩm --", new { @class = "form-control" })
    </div>
    <div class="form-group">
        <label>Số lượng</label>
        <input type="number" name="soLuong" value="1" min="1" class="form-control" />
    </div>
    <button type="submit" class="btn">Thêm món</button>
}
