@model App12COFFEE.Models.DonHang
@{
    ViewBag.Title = "Xóa đơn hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    h2 {
        color: #C9A86A;
        margin-bottom: 20px;
    }

    p {
        margin-bottom: 20px;
    }

    .table {
        width: 60%;
        border-collapse: collapse;
        margin-top: 20px;
    }

        .table th, .table td {
            padding: 10px;
            border: 1px solid #444;
            text-align: left;
        }

        .table th {
            background: #333;
            color: #fff;
            width: 30%;
        }

    .btn {
        padding: 8px 16px;
        background: #C9A86A;
        color: #000;
        border-radius: 5px;
        text-decoration: none;
        margin-right: 10px;
    }

        .btn:hover {
            background: #b8974d;
        }

    .btn-danger {
        background: #dc3545;
        color: #fff !important;
    }

        .btn-danger:hover {
            background: #b52a37;
        }
</style>

<h2>Xóa đơn hàng</h2>
<p>Bạn có chắc chắn muốn xóa đơn hàng này?</p>

<table class="table">
    <tr><th>Mã đơn hàng</th><td>@Model.MaDH</td></tr>
    <tr><th>Ngày đặt</th><td>@Model.NgayDat?.ToString("dd/MM/yyyy HH:mm")</td></tr>
    <tr><th>Tổng tiền</th><td>@String.Format("{0:N0}", Model.TongTien ?? 0m) VND</td></tr>
</table>

@using (Html.BeginForm("Delete", "DonHangAdmin", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.MaDH)
    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
    <a href="@Url.Action("Index","DonHangAdmin")" class="btn">Hủy</a>
}
