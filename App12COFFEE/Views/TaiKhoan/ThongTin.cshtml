@model App12COFFEE.Models.NguoiDung
@{
    ViewBag.Title = "Thông tin tài khoản";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<link rel="stylesheet" href="~/Content/ThongTinNguoiDung.css" />

<div class="profile-wrapper">
    <div class="profile-card">

        <div class="profile-header">
            <div class="avatar">
                <i class="fa-regular fa-user"></i>
            </div>
            <div class="header-text">
                <h2>Thông tin người dùng</h2>
                <p>Xem thông tin & cập nhật địa chỉ, đổi mật khẩu</p>
            </div>
        </div>

        @if (TempData["Message"] != null)
        {
            <div class="profile-alert success">@TempData["Message"]</div>
        }

        <!-- ================== THÔNG TIN (KHÔNG ĐƯỢC SỬA) ================== -->
        <div class="section-title">Thông tin cá nhân</div>

        <div class="profile-grid">
            <div class="form-group full">
                <label>Tên đăng nhập</label>
                <input class="input input-readonly" value="@Model.TenDangNhap" readonly />
            </div>

            <div class="form-group">
                <label>Họ tên</label>
                <input class="input input-readonly" value="@Model.HoTen" readonly />
            </div>

            <div class="form-group">
                <label>Số điện thoại</label>
                <input class="input input-readonly" value="@Model.DienThoai" readonly />
            </div>

            <div class="form-group full">
                <label>Email</label>
                <input class="input input-readonly" value="@Model.Email" readonly />
            </div>
        </div>

        <div class="divider"></div>

        <!-- ================== FORM CẬP NHẬT ĐỊA CHỈ ================== -->
        <div class="section-title">Địa chỉ giao hàng</div>

        @using (Html.BeginForm("CapNhatDiaChi", "TaiKhoan", FormMethod.Post, new { @class = "address-form" }))
        {
            @Html.AntiForgeryToken()

            <div class="profile-grid">
                <div class="form-group full">
                    <label>Địa chỉ giao hàng</label>
                    <input class="input" id="DiaChiGiaoHang" name="DiaChiGiaoHang" value="@Model.DiaChiGiaoHang" />
                </div>

                <div class="form-group">
                    <label>Tỉnh</label>
                    <input class="input" id="Tinh" name="Tinh" value="@Model.Tinh" />
                </div>

                <div class="form-group">
                    <label>Huyện</label>
                    <input class="input" id="Huyen" name="Huyen" value="@Model.Huyen" />
                </div>

                <div class="form-group full">
                    <label>Xã</label>
                    <input class="input" id="Xa" name="Xa" value="@Model.Xa" />
                </div>
            </div>
            <div class="profile-actions">
                <button type="button" class="btn btn-outline" id="btnEdit">Chỉnh sửa</button>
                <button type="submit" class="btn btn-primary" id="btnSave" style="display:none;">Lưu</button>
                <a href="@Url.Action("ThongTin","TaiKhoan")" class="btn btn-ghost" id="btnCancel" style="display:none;">Hủy</a>
            </div>
        }

        <div class="divider"></div>

        <!-- ================== FORM ĐỔI MẬT KHẨU ================== -->
        <div class="section-title">Đổi mật khẩu</div>

        @if (TempData["PassError"] != null)
        {
            <div class="profile-alert danger">@TempData["PassError"]</div>
        }
        @if (TempData["PassMessage"] != null)
        {
            <div class="profile-alert success">@TempData["PassMessage"]</div>
        }

        @using (Html.BeginForm("DoiMatKhau", "TaiKhoan", FormMethod.Post, new { @class = "password-form" }))
        {
            @Html.AntiForgeryToken()

            <div class="profile-grid">
                <div class="form-group full">
                    <label>Mật khẩu hiện tại</label>
                    <input class="input" name="MatKhauHienTai" type="password" required />
                </div>

                <div class="form-group">
                    <label>Mật khẩu mới</label>
                    <input class="input" name="MatKhauMoi" type="password" minlength="8" required />
                    <div class="hint">>= 8 ký tự • Có chữ thường • chữ hoa • số • ký tự đặc biệt</div>
                </div>

                <div class="form-group">
                    <label>Xác nhận mật khẩu mới</label>
                    <input class="input" name="XacNhanMatKhauMoi" type="password" minlength="8" required />
                </div>
            </div>

            <div class="profile-actions">
                <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
            </div>
        }

    </div>
</div>

@section Scripts {
    <script>
        // Chỉ cho sửa địa chỉ
        const ids = ["DiaChiGiaoHang", "Tinh", "Huyen", "Xa"];
        const fields = ids.map(id => document.getElementById(id)).filter(Boolean);

        const btnEdit = document.getElementById("btnEdit");
        const btnSave = document.getElementById("btnSave");
        const btnCancel = document.getElementById("btnCancel");

        function setReadonly(isReadonly) {
            fields.forEach(f => {
                f.readOnly = isReadonly;
                f.classList.toggle("input-readonly", isReadonly);
            });
        }

        // mặc định khóa
        setReadonly(true);

        btnEdit.addEventListener("click", () => {
            setReadonly(false);
            btnEdit.style.display = "none";
            btnSave.style.display = "inline-block";
            btnCancel.style.display = "inline-block";
            fields[0]?.focus();
        });
    </script>
}
