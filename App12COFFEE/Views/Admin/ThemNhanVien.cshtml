@model App12COFFEE.Models.NguoiDung
@{
    ViewBag.Title = "Thêm nhân viên";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    h2 {
        color: #C9A86A;
        margin-bottom: 20px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        color: #fff;
        margin-bottom: 5px;
        display: block;
    }

    .form-control {
        background: #222;
        color: #fff;
        border: 1px solid #444;
        border-radius: 5px;
        padding: 8px;
    }

    .btn {
        padding: 8px 16px;
        border-radius: 5px;
        text-decoration: none;
        margin-right: 5px;
    }

    .btn-success {
        background: #C9A86A;
        color: #000;
    }

        .btn-success:hover {
            background: #b8974d;
        }

    .btn-secondary {
        background: #6c757d;
        color: #fff;
    }

        .btn-secondary:hover {
            background: #5a6268;
        }
</style>

<h2>Thêm nhân viên mới</h2>

@using (Html.BeginForm("ThemNhanVien", "Admin", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(m => m.TenDangNhap, "Tên đăng nhập")
        @Html.TextBoxFor(m => m.TenDangNhap, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.HoTen, "Họ tên")
        @Html.TextBoxFor(m => m.HoTen, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Email, "Email")
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.MatKhau, "Mật khẩu")
        @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.DienThoai, "Điện thoại")
        @Html.TextBoxFor(m => m.DienThoai, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.Label("Loại nhân viên")
        @Html.DropDownList("VaiTro",
            new SelectList(new[]
            {
                new { Value = "NhanVienGiaoHang", Text = "Nhân viên giao hàng" },
                new { Value = "NhanVienDuyetDon", Text = "Nhân viên duyệt đơn" }
            }, "Value", "Text"),
            "-- Chọn loại nhân viên --",
            new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-success">Thêm nhân viên</button>
    <a href="@Url.Action("ThongTinNhanVien","Admin")" class="btn btn-secondary">Quay lại</a>
}
