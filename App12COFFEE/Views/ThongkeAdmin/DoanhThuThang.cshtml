@{
    ViewBag.Title = "Doanh thu theo tháng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    h2 {
        color: #C9A86A;
        margin-bottom: 20px;
    }

    .chart-container {
        background: #222;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.3);
    }
</style>

<h2>Doanh thu theo tháng</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<div class="chart-container">
    <canvas id="doanhThuChart" width="600" height="300"></canvas>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    var doanhThuData = @Html.Raw(ViewBag.DoanhThuTheoThang);

    var months = doanhThuData.map(function(item) { return item.Thang + '/' + item.Nam; });
    var doanhThu = doanhThuData.map(function(item) { return item.DoanhThu; });

    var ctx = document.getElementById('doanhThuChart').getContext('2d');
    var doanhThuChart = new Chart(ctx, {
        type: 'line',
        data: {
            labels: months,
            datasets: [{
                label: 'Doanh thu (VND)',
                data: doanhThu,
                borderColor: '#C9A86A',
                backgroundColor: 'rgba(201, 168, 106, 0.2)',
                fill: true,
                tension: 0.3
            }]
        },
        options: {
            plugins: {
                legend: { labels: { color: '#fff' } }
            },
            scales: {
                x: { ticks: { color: '#fff' } },
                y: { ticks: { color: '#fff' } }
            }
        }
    });
</script>