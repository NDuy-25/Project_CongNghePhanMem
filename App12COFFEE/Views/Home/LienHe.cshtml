@{
    ViewBag.Title = "Liên hệ";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<link rel="stylesheet" href="~/Content/contact.css" />

<div class="coffee-contact-wrapper">

    <div class="coffee-header animate-fade">
        <h2>Liên hệ 12 COFFEE</h2>
        <p>Kết nối với chúng tôi qua các nền tảng sau</p>
    </div>

    <div class="coffee-grid">

        <!-- Facebook -->
        <div class="coffee-card animate-up delay-1">
            <img src="~/Content/Images/facebook.png" class="coffee-icon" />
            <h3>Facebook</h3>
            <p>Fanpage chính thức của 12 COFFEE</p>
            <a href="https://www.facebook.com/12coffeee" target="_blank" class="coffee-btn">Truy cập</a>
        </div>

        <!-- Instagram -->
        <div class="coffee-card animate-up delay-2">
            <img src="~/Content/Images/instagram.png" class="coffee-icon" />
            <h3>Instagram</h3>
            <p>Theo dõi để xem hình ảnh mới nhất</p>
            <a href="https://www.instagram.com/onetwocoffeee?igsh=cm9mazU5bTVnZXRk" target="_blank" class="coffee-btn">Truy cập</a>
        </div>

        <!-- Hotline -->
        <div class="coffee-card animate-up delay-3">
            <img src="~/Content/Images/phone.png" class="coffee-icon" />
            <h3>Hotline</h3>
            <p>Liên hệ nhanh chóng</p>
            <div class="coffee-hotline">0901 234 567</div>
        </div>

        <!-- Địa chỉ -->
        <div class="coffee-card animate-up delay-4">
            <img src="~/Content/Images/location.png" class="coffee-icon" />
            <h3>Địa chỉ</h3>
            <p>12 Tô Hiến Thành, Vạn Ninh, Khánh Hòa</p>
        </div>

    </div>

</div>
