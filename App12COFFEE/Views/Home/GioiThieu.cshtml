@{
    ViewBag.Title = "Giới thiệu 12COFFEE";
    Layout = "~/Views/Shared/_LayoutUser.cshtml";
}

<link rel="stylesheet" href="~/Content/GioiThieu.css" />

<div class="gioithieu-wrapper">

    <!-- PHẦN NGUỒN GỐC -->
    <div class="section">
        <div class="section-text">
            <h2>NGUỒN GỐC</h2>
            <p>
                12COFFEE được thành lập từ niềm đam mê với hương vị cà phê Việt và mong muốn tạo ra một không gian kết nối giữa con người.
                Chúng tôi tin rằng mỗi ly cà phê là một câu chuyện, một trải nghiệm đáng nhớ.
            </p>
        </div>
        <div class="section-image">
            <img src="~/Content/banner12.jpg" alt="Nguồn gốc cà phê" />
        </div>
    </div>

    <!-- PHẦN DỊCH VỤ -->
    <div class="section reverse">
        <div class="section-text">
            <h2>DỊCH VỤ</h2>
            <div><p>
                Chúng tôi cam kết mang đến trải nghiệm thoải mái, thân thiện và hiện đại.
                Mỗi góp ý của bạn là động lực để 12COFFEE hoàn thiện hơn mỗi ngày.
            </p></div>
        </div>
        <div class="section-image">
            <img src="~/Content/Images/location.png" alt="Dịch vụ khách hàng" />
        </div>
    </div>

</div>
